{
  "ConnectionStrings": {
    "InboxCurator": "Data Source=storage/inbox-curator.db"
  },
  "Gmail": {
    "ApplicationName": "InboxCurator",
    "ClientSecretsPath": "client_secret.json",
    "TokenStorePath": "tokens",
    "ScanOnStartup": false,
    "PageSize": 250,
    "MaxRetryAttempts": 6
  },
  "LocalPort": 5137,
  "SeedSyntheticData": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Google": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
