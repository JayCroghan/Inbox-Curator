@page
@model IndexModel
@{
    ViewData["Title"] = "Mailbox triage";
    var lastCompleted = Model.Result.Checkpoints
        .Where(checkpoint => checkpoint.CompletedAtUtc.HasValue)
        .OrderByDescending(checkpoint => checkpoint.CompletedAtUtc)
        .FirstOrDefault();
    var anyFailed = Model.Result.Checkpoints.Any(checkpoint => checkpoint.State == ScanState.Failed);
    var lastBeforeValue = Model.LastBefore?.ToString("yyyy-MM-dd");
}

<div class="workspace" data-scan-running="@Model.ScanIsRunning.ToString().ToLowerInvariant()">
    <section class="workspace-heading triage-heading" aria-labelledby="page-title">
        <div>
            <p class="eyebrow">Human seed policy · local only</p>
            <h1 id="page-title">Mailbox triage</h1>
            <p class="heading-note">Decide at the sender or List-ID level. Every choice is stored locally as future policy intent; Gmail remains unchanged.</p>
        </div>
        <div class="scan-console">
            <div class="scan-state">
                <span class="status-dot @(Model.ScanIsRunning ? "is-active" : anyFailed ? "is-error" : "")" aria-hidden="true"></span>
                <div>
                    <strong>@(Model.ScanIsRunning ? "Scan in progress" : anyFailed ? "Scan needs attention" : "Census ready")</strong>
                    <span>
                        @if (Model.ScanIsRunning)
                        {
                            <text>Refreshing this view automatically</text>
                        }
                        else if (lastCompleted is not null)
                        {
                            <text>Last completed @lastCompleted.CompletedAtUtc!.Value.ToString("d MMM yyyy, HH:mm") UTC</text>
                        }
                        else
                        {
                            <text>No Gmail scan has run yet</text>
                        }
                    </span>
                </div>
            </div>
            <form method="post" asp-page-handler="Scan">
                <input type="hidden" name="ReturnUrl" value="@Model.CurrentUrl" />
                <button class="scan-button" type="submit" disabled="@Model.ScanIsRunning">
                    <span>@(Model.ScanIsRunning ? "Scanning…" : "Refresh census")</span>
                    <span aria-hidden="true">↗</span>
                </button>
            </form>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="notice" role="status">@Model.Notice</div>
    }

    <section class="metrics triage-metrics" aria-label="Mailbox decision summary">
        <div><span>Total messages</span><strong>@Model.Result.Metrics.MessageCount.ToString("N0")</strong></div>
        <div><span>Total sources</span><strong>@Model.Result.Metrics.GroupCount.ToString("N0")</strong></div>
        <div><span>Undecided sources</span><strong>@Model.Result.Metrics.UndecidedGroupCount.ToString("N0")</strong></div>
        <div><span>Undecided messages</span><strong>@Model.Result.Metrics.UndecidedMessageCount.ToString("N0")</strong></div>
        <div><span>Kept / protected</span><strong>@Model.Result.Metrics.KeptMessageCount.ToString("N0")</strong></div>
        <div><span>Intended quarantine</span><strong>@Model.Result.Metrics.IntendedQuarantineMessageCount.ToString("N0")</strong></div>
        <div><span>Age-rule affected</span><strong>@Model.Result.Metrics.AgeRuleAffectedMessageCount.ToString("N0")</strong></div>
        <div><span>Mailbox covered</span><strong>@Model.Result.Metrics.CoveragePercentage.ToString("0.0")%</strong></div>
    </section>

    <section class="decision-progress" aria-label="Decision progress">
        <strong>@Model.Result.Metrics.DecisionCount.ToString("N0") decisions cover @Model.Result.Metrics.CoveragePercentage.ToString("0.0")% of your mailbox.</strong>
        <span>@Model.Result.Metrics.CoveredMessageCount.ToString("N0") messages have explicit human policy · @Model.Result.Metrics.RelationshipCount.ToString("N0") messages carry relationship evidence</span>
        <progress max="100" value="@Model.Result.Metrics.CoveragePercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">@Model.Result.Metrics.CoveragePercentage.ToString("0.0")%</progress>
    </section>

    <section class="census triage-ledger" aria-labelledby="census-title">
        <div class="census-toolbar">
            <div>
                <p class="eyebrow">Highest leverage first</p>
                <h2 id="census-title">Source decisions</h2>
            </div>
            <p class="toolbar-note">Default order places undecided clusters first, then sorts by message volume.</p>
        </div>

        <form method="get" class="triage-filters" role="search">
            <label class="search-filter">
                <span>Search</span>
                <input type="search" name="q" value="@Model.Search" placeholder="Sender, List-ID or subject" />
            </label>
            <label>
                <span>Decision</span>
                <select name="decisionState" data-auto-submit>
                    <option value="all" selected="@(Model.DecisionState == "all")">All · undecided first</option>
                    <option value="undecided" selected="@(Model.DecisionState == "undecided")">Undecided only</option>
                    <option value="decided" selected="@(Model.DecisionState == "decided")">Decided</option>
                </select>
            </label>
            <label>
                <span>Relationship</span>
                <select name="relationship" data-auto-submit>
                    <option value="all" selected="@(Model.Relationship == "all")">Any</option>
                    <option value="known" selected="@(Model.Relationship == "known")">Known relationship</option>
                    <option value="none" selected="@(Model.Relationship == "none")">No relationship</option>
                </select>
            </label>
            <label>
                <span>Category</span>
                <select name="promotion" data-auto-submit>
                    <option value="all" selected="@(Model.Promotion == "all")">Any</option>
                    <option value="promotions" selected="@(Model.Promotion == "promotions")">Promotions</option>
                    <option value="non-promotions" selected="@(Model.Promotion == "non-promotions")">Non-promotions</option>
                </select>
            </label>
            <label>
                <span>Grouping</span>
                <select name="kind" data-auto-submit>
                    <option value="all" selected="@(Model.Kind == "all")">List-ID + sender</option>
                    <option value="list" selected="@(Model.Kind == "list")">List-ID</option>
                    <option value="sender" selected="@(Model.Kind == "sender")">Sender</option>
                </select>
            </label>
            <label>
                <span>Last received before</span>
                <select name="stalePreset" data-auto-submit>
                    <option value="all" selected="@(Model.StalePreset == "all")">Any time</option>
                    <option value="30" selected="@(Model.StalePreset == "30")">30 days ago</option>
                    <option value="90" selected="@(Model.StalePreset == "90")">90 days ago</option>
                    <option value="365" selected="@(Model.StalePreset == "365")">1 year ago</option>
                    <option value="custom" selected="@(Model.StalePreset == "custom")">Custom date</option>
                </select>
            </label>
            <label>
                <span>Custom stale date</span>
                <input type="date" name="lastBefore" value="@lastBeforeValue" />
            </label>
            <label class="page-size">
                <span>Rows</span>
                <select name="pageSize" data-auto-submit>
                    @foreach (var size in new[] { 10, 25, 50, 100 })
                    {
                        <option value="@size" selected="@(Model.Result.PageSize == size)">@size</option>
                    }
                </select>
            </label>
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="hidden" name="dir" value="@Model.Direction" />
            <input type="hidden" name="pageNumber" value="1" />
            <button type="submit">Apply</button>
        </form>

        <div class="table-shell">
            <table class="triage-table">
                <thead>
                    <tr>
                        <th class="source-column"><a asp-all-route-data='@Model.RouteValues("sender", Model.NextDirection("sender"), 1)'>Sender / list <span>@Model.SortIndicator("sender")</span></a></th>
                        <th class="decision-column">Human decision</th>
                        <th class="numeric"><a asp-all-route-data='@Model.RouteValues("count", Model.NextDirection("count"), 1)'>Messages <span>@Model.SortIndicator("count")</span></a></th>
                        <th><a asp-all-route-data='@Model.RouteValues("first", Model.NextDirection("first"), 1)'>First <span>@Model.SortIndicator("first")</span></a></th>
                        <th><a asp-all-route-data='@Model.RouteValues("last", Model.NextDirection("last"), 1)'>Last <span>@Model.SortIndicator("last")</span></a></th>
                        <th class="numeric"><a asp-all-route-data='@Model.RouteValues("unread", Model.NextDirection("unread"), 1)'>Unread <span>@Model.SortIndicator("unread")</span></a></th>
                        <th class="numeric"><a asp-all-route-data='@Model.RouteValues("starred", Model.NextDirection("starred"), 1)'>Starred <span>@Model.SortIndicator("starred")</span></a></th>
                        <th class="numeric"><a asp-all-route-data='@Model.RouteValues("important", Model.NextDirection("important"), 1)'>Important <span>@Model.SortIndicator("important")</span></a></th>
                        <th class="numeric"><a asp-all-route-data='@Model.RouteValues("relationship", Model.NextDirection("relationship"), 1)'>Related <span>@Model.SortIndicator("relationship")</span></a></th>
                        <th><a asp-all-route-data='@Model.RouteValues("promotion", Model.NextDirection("promotion"), 1)'>Promotions <span>@Model.SortIndicator("promotion")</span></a></th>
                        <th class="subjects-column">Representative subjects</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result.Groups.Count == 0)
                    {
                        <tr><td colspan="11" class="empty-state">No sources match these triage filters.</td></tr>
                    }
                    @foreach (var group in Model.Result.Groups)
                    {
                        <tr class="@(group.IsDecided ? "is-decided-row" : "")">
                            <td class="source-cell">
                                <a class="source-link" asp-page="/Clusters/Detail" asp-route-targetType="@group.TargetType" asp-route-targetValue="@group.TargetValue" asp-route-returnUrl="@Model.CurrentUrl">
                                    <strong>@group.Display</strong>
                                    <span>@group.Kind · @group.TargetValue</span>
                                </a>
                            </td>
                            <td>
                                @await Html.PartialAsync("_DecisionControls", new DecisionControlsModel(
                                    group.TargetType,
                                    group.TargetValue,
                                    group.DecisionKind,
                                    group.DecisionCutoffDateUtc,
                                    group.AffectedMessageCount,
                                    Model.CurrentUrl))
                            </td>
                            <td class="numeric count-cell">@group.MessageCount.ToString("N0")</td>
                            <td><time datetime="@group.FirstDateUtc.ToString("O")">@group.FirstDateUtc.ToString("dd MMM yy")</time></td>
                            <td><time datetime="@group.LastDateUtc.ToString("O")">@group.LastDateUtc.ToString("dd MMM yy")</time></td>
                            <td class="numeric">@group.UnreadCount</td>
                            <td class="numeric">@group.StarredCount</td>
                            <td class="numeric">@group.ImportantCount</td>
                            <td class="numeric relationship-cell">@(group.RelationshipCount > 0 ? group.RelationshipCount : "—")</td>
                            <td>
                                <div class="promotion" title="@group.PromotionPercentage.ToString("0.#")% promotions">
                                    <progress max="100" value="@group.PromotionPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">@group.PromotionPercentage.ToString("0")%</progress>
                                    <em>@group.PromotionPercentage.ToString("0")%</em>
                                </div>
                            </td>
                            <td>
                                <ul class="subjects">
                                    @foreach (var subject in group.RepresentativeSubjects)
                                    {
                                        <li>@subject</li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="pagination" aria-label="Triage pages">
            <span>Page @Model.Result.Page of @Model.Result.TotalPages · @Model.Result.TotalGroups matching sources</span>
            <div>
                <a class="@(Model.Result.Page <= 1 ? "is-disabled" : "")" asp-all-route-data='@Model.RouteValues(pageNumber: Model.Result.Page - 1)' aria-disabled="@(Model.Result.Page <= 1)">← Previous</a>
                <a class="@(Model.Result.Page >= Model.Result.TotalPages ? "is-disabled" : "")" asp-all-route-data='@Model.RouteValues(pageNumber: Model.Result.Page + 1)' aria-disabled="@(Model.Result.Page >= Model.Result.TotalPages)">Next →</a>
            </div>
        </nav>
    </section>
</div>
