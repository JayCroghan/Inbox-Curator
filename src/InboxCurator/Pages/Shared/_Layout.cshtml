<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · Inbox Curator</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="wordmark" asp-page="/Index" aria-label="Inbox Curator home">
            <span class="wordmark-mark" aria-hidden="true">IC</span>
            <span>Inbox Curator</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
            <a asp-page="/Index">Triage</a>
            <a asp-page="/Classifier">Classifier lab</a>
        </nav>
        <div class="privacy-note"><span aria-hidden="true">●</span> Local only · Gmail read-only</div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>Metadata census</span>
        <span>No bodies. No mailbox changes.</span>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
